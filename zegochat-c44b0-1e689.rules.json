{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "new_males_pool": {
      ".indexOn": ["languageKey", "isOnline", "lastSeen", "createdAt"]
    },
    "new_males_buckets": {
      "$languageKey": {
        ".indexOn": ["isOnline", "lastSeen"]
      }
    },
    "calls": {
      ".indexOn": ["callerId", "receiverId", "status", "createdAt"]
    },
    "free_intro_call_records": {
      ".indexOn": ["used", "usedAt"]
    }
  }
}
